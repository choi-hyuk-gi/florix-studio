<script>
// ============================================================
// v10 안전 발행 — 핵심 개선사항
// ============================================================
// 1. 토큰 권한 사전 체크 (write 권한 확인)
// 2. PUT 응답의 commit SHA 검증
// 3. GET으로 저장 확인 (round-trip verification)
// 4. 모든 에러를 묵음 처리 없이 즉시 표시
// 5. editingSha 상태 누락 방지 (매번 fresh fetch)
// 6. "발행 완료"는 검증 후에만 표시
// ============================================================

const REPO='choi-hyuk-gi/florix-studio';
const BRANCH='main';
const DRAFT_KEY='florix-bulk-write-draft-v1';
const COLORS=[
  {name:'검정',code:'#1A1A1A'},
  {name:'브라운',code:'#B8956A'},
  {name:'빨강',code:'#C62828'},
  {name:'주황',code:'#E29A4A'},
  {name:'초록',code:'#2E7D32'},
  {name:'회색',code:'#888888'}
];
const EMOJIS=['😊','👍','✨','🔥','💡','📷','🏠','🏢','☕','🎨','✅','⭐','→','•','▪','◆','🛠️','🔧','💎','🌿','😅','👏','🙏','🎉','💪','😉','📝','📌','⚡','🎯','💭','🌟'];

// ========== 토큰 ==========
function getToken(){
  try{
    for(let i=0;i<localStorage.length;i++){
      const k=localStorage.key(i);
      if(k&&(k.includes('cms-user')||k.includes('netlify-cms-user')||k.includes('gotrue'))){
        try{const v=JSON.parse(localStorage.getItem(k));if(v&&v.token)return v.token}catch(e){}
      }
    }
  }catch(e){}
  return null;
}
const TOKEN=getToken();
let TOKEN_VERIFIED=false; // 토큰 write 권한 확인 여부

if(!TOKEN){
  document.getElementById('loginGate').style.display='block';
}else{
  document.getElementById('editor').style.display='block';
  document.getElementById('fab').style.display='flex';
  document.getElementById('bottomBar').style.display='flex';
  document.getElementById('pubBtn').disabled=false;
  document.getElementById('pubBtn2').disabled=false;
  document.getElementById('date').value=new Date().toISOString().split('T')[0];
  // 페이지 로드 시 토큰 권한 사전 확인
  verifyTokenPermissions();
}

// ========== 토큰 권한 사전 확인 ==========
async function verifyTokenPermissions(){
  const el=document.getElementById('tokenStatus');
  el.className='status show info';
  el.textContent='🔐 GitHub 권한 확인 중...';
  try{
    // 1. 레포 접근 가능한지 확인
    const repoUrl='https://api.github.com/repos/'+REPO;
    const repoRes=await fetch(repoUrl,{headers:{'Authorization':'Bearer '+TOKEN,'Accept':'application/vnd.github.v3+json'}});
    if(!repoRes.ok){
      throw new Error('레포 접근 실패 (HTTP '+repoRes.status+'). 토큰이 만료되었거나 권한이 없습니다.');
    }
    const repoData=await repoRes.json();
    // 2. push 권한이 있는지 확인 (permissions 필드)
    const perms=repoData.permissions||{};
    if(!perms.push&&!perms.admin&&!perms.maintain){
      throw new Error('이 토큰은 쓰기(push) 권한이 없습니다. CMS에 다시 로그인하거나 토큰 권한을 확인하세요.');
    }
    TOKEN_VERIFIED=true;
    el.className='status show success';
    el.innerHTML='✓ GitHub 쓰기 권한 확인됨 ('+REPO+', '+BRANCH+' 브랜치)';
    setTimeout(()=>{el.className='status'},4000);
  }catch(e){
    TOKEN_VERIFIED=false;
    el.className='status show error';
    el.innerHTML='⚠️ <strong>발행이 작동하지 않을 수 있습니다.</strong><br>'+e.message+'<br><a href="/admin/" style="color:#1A56DB;text-decoration:underline">CMS에 다시 로그인하기</a>';
    // 발행 버튼 비활성화
    document.getElementById('pubBtn').disabled=true;
    document.getElementById('pubBtn2').disabled=true;
  }
}

// ========== 상태 ==========
let blocks=[];
let blockIdCounter=0;
let editingPath=null;
let editingSha=null;
let isDirty=false;
let saveTimer=null;
let thumbOverride=null;

function nextId(){return 'b'+(++blockIdCounter)}

// ========== 상태 표시 ==========
function showStatus(type,msg){
  const el=document.getElementById('status');
  el.className='status show '+type;
  el.textContent=msg;
  if(type==='success')setTimeout(()=>{el.className='status'},5000);
}

function setSaveState(state){
  const ind=document.getElementById('saveInd');
  ind.className='save-indicator '+state;
  const t=ind.querySelector('.text');
  if(state==='changed')t.textContent='변경됨';
  else if(state==='saved')t.textContent='저장됨';
  else if(state==='error')t.textContent='저장 실패';
  else t.textContent='준비됨';
}

// ========== 자동 저장 ==========
function markDirty(){
  isDirty=true;
  setSaveState('changed');
  clearTimeout(saveTimer);
  saveTimer=setTimeout(saveDraft,3000);
}

function saveDraft(){
  if(!isDirty)return;
  try{
    const draft={
      meta:getMeta(),
      blocks:blocks.map(b=>{
        if(b.type==='text')return{type:'text',content:b.content};
        if(b.type==='image'){
          const obj={type:'image',src:b.src||null,filename:b.filename,caption:b.caption,uploaded:b.uploaded,existing:!!b.existing,isThumbnail:b.isThumbnail,uploadedPath:b.uploadedPath||null};
          if(!b.existing&&b.dataUrl&&b.dataUrl.length<2000000)obj.dataUrl=b.dataUrl;
          return obj;
        }
      }),
      thumbOverride:thumbOverride?{
        filename:thumbOverride.filename,
        src:thumbOverride.src,
        uploaded:thumbOverride.uploaded,
        uploadedPath:thumbOverride.uploadedPath,
        dataUrl:(!thumbOverride.uploaded&&thumbOverride.dataUrl&&thumbOverride.dataUrl.length<2000000)?thumbOverride.dataUrl:null
      }:null,
      editingPath,
      editingSha,
      savedAt:Date.now()
    };
    const json=JSON.stringify(draft);
    if(json.length<4900000){
      localStorage.setItem(DRAFT_KEY,json);
    }else{
      draft.blocks.forEach(b=>{if(b.type==='image')delete b.dataUrl});
      localStorage.setItem(DRAFT_KEY,JSON.stringify(draft));
    }
    isDirty=false;
    setSaveState('saved');
  }catch(e){
    console.error(e);
    setSaveState('error');
  }
}

window.addEventListener('beforeunload',()=>{if(isDirty)saveDraft()});

// ========== 메타 ==========
function getMeta(){
  return{
    title:document.getElementById('title').value,
    location:document.getElementById('location').value,
    category:document.getElementById('category').value,
    date:document.getElementById('date').value,
    area:document.getElementById('area').value,
    duration:document.getElementById('duration').value,
    specs:document.getElementById('specs').value
  };
}

function setMeta(m){
  if(!m)return;
  document.getElementById('title').value=m.title||'';
  document.getElementById('location').value=m.location||'';
  document.getElementById('category').value=m.category||'주거';
  document.getElementById('date').value=m.date||'';
  document.getElementById('area').value=m.area||'';
  document.getElementById('duration').value=m.duration||'1일 완공';
  document.getElementById('specs').value=m.specs||'';
}

['title','location','category','date','area','duration','specs'].forEach(id=>{
  const el=document.getElementById(id);
  if(el)el.addEventListener('input',markDirty);
  if(el)el.addEventListener('change',markDirty);
});

// ========== 드래프트 ==========
function checkDraft(){
  if(!TOKEN)return;
  try{
    const raw=localStorage.getItem(DRAFT_KEY);
    if(!raw)return;
    const d=JSON.parse(raw);
    if(d&&d.blocks&&d.blocks.length>0){
      document.getElementById('draftBanner').style.display='flex';
    }
  }catch(e){}
}

function restoreDraft(){
  try{
    const d=JSON.parse(localStorage.getItem(DRAFT_KEY));
    setMeta(d.meta);
    blocks=[];blockIdCounter=0;
    for(const b of d.blocks){
      if(b.type==='text'){
        blocks.push({id:nextId(),type:'text',content:b.content||''});
      }else if(b.type==='image'){
        blocks.push({
          id:nextId(),type:'image',
          src:b.src,filename:b.filename,caption:b.caption||'',
          dataUrl:b.dataUrl||b.src,
          uploaded:!!b.uploaded,existing:!!b.existing,
          uploadedPath:b.uploadedPath||null,
          isThumbnail:!!b.isThumbnail,file:null
        });
      }
    }
    editingPath=d.editingPath||null;
    editingSha=d.editingSha||null;
    thumbOverride=null;
    if(d.thumbOverride){
      thumbOverride={
        filename:d.thumbOverride.filename,src:d.thumbOverride.src,
        uploaded:!!d.thumbOverride.uploaded,uploadedPath:d.thumbOverride.uploadedPath,
        dataUrl:d.thumbOverride.dataUrl||d.thumbOverride.src,file:null
      };
    }
    if(editingPath){
      document.getElementById('editingBanner').style.display='flex';
      document.getElementById('editingTitle').textContent=d.meta.title||'(제목 없음)';
    }
    document.getElementById('draftBanner').style.display='none';
    renderBlocks();updateSummary();setSaveState('saved');
    const imgWithoutData=blocks.filter(b=>b.type==='image'&&!b.existing&&!b.dataUrl).length;
    if(imgWithoutData>0){
      showStatus('error','⚠️ '+imgWithoutData+'장의 새 사진이 복원되지 않았습니다. 해당 사진은 다시 첨부해주세요.');
    }else{
      showStatus('success','✅ 작성하던 글을 복원했습니다');
    }
  }catch(e){showStatus('error','복원 실패: '+e.message)}
}

function discardDraft(){
  if(!confirm('정말 새로 시작할까요? 임시 저장 데이터가 삭제됩니다.'))return;
  localStorage.removeItem(DRAFT_KEY);
  document.getElementById('draftBanner').style.display='none';
  showStatus('info','새로 시작합니다');
}

// ========== 블록 ==========
function updateSummary(){
  const ic=blocks.filter(b=>b.type==='image').length;
  document.getElementById('blockCount').textContent=blocks.length;
  document.getElementById('imageCount').textContent=ic;
}

function addTextBlock(content='',scroll=true){
  const id=nextId();
  blocks.push({id,type:'text',content});
  renderBlocks();updateSummary();markDirty();
  setTimeout(()=>{
    const el=document.querySelector('#'+id+' .text-content');
    if(el){el.focus();if(scroll)el.scrollIntoView({behavior:'smooth',block:'center'})}
  },50);
}

function addImageBlock(file){
  const id=nextId();
  const reader=new FileReader();
  reader.onload=e=>{
    const isFirstImage=!blocks.some(b=>b.type==='image');
    blocks.push({
      id,type:'image',file,filename:file.name,
      dataUrl:e.target.result,caption:'',
      uploaded:false,existing:false,isThumbnail:isFirstImage
    });
    renderBlocks();updateSummary();markDirty();
  };
  reader.readAsDataURL(file);
}

function deleteBlock(id){
  if(!confirm('이 블록을 삭제할까요?'))return;
  blocks=blocks.filter(b=>b.id!==id);
  renderBlocks();updateSummary();markDirty();
}

function moveBlock(id,dir){
  const i=blocks.findIndex(b=>b.id===id);
  const j=i+dir;
  if(j<0||j>=blocks.length)return;
  [blocks[i],blocks[j]]=[blocks[j],blocks[i]];
  renderBlocks();markDirty();
}

function setThumbnail(id){
  blocks.forEach(b=>{if(b.type==='image')b.isThumbnail=(b.id===id)});
  thumbOverride=null;
  renderBlocks();updateThumbPreview();markDirty();
  showStatus('success','대표 사진이 변경되었습니다');
}

function updateCaption(id,v){
  const b=blocks.find(x=>x.id===id);
  if(b){b.caption=v;markDirty()}
}

function updateTextContent(id,html){
  const b=blocks.find(x=>x.id===id);
  if(b){b.content=html;markDirty()}
}

// ========== 대표 사진 ==========
function getThumbSource(){
  if(thumbOverride)return{src:thumbOverride.dataUrl||thumbOverride.src,label:thumbOverride.filename||'대표 사진(별도)',override:true};
  const starred=blocks.find(b=>b.type==='image'&&b.isThumbnail);
  if(starred)return{src:starred.dataUrl||starred.src,label:starred.filename||'본문 사진',override:false};
  const first=blocks.find(b=>b.type==='image');
  if(first)return{src:first.dataUrl||first.src,label:(first.filename||'본문 사진')+' (자동)',override:false};
  return null;
}

function updateThumbPreview(){
  const box=document.getElementById('thumbBox');
  if(!box)return;
  const t=getThumbSource();
  if(t){
    box.className='thumb-box has-image';
    box.innerHTML=
      '<img src="'+t.src+'" class="thumb-img" alt="대표 사진" onerror="this.parentElement.classList.remove(\'has-image\');this.outerHTML=\'<div class=thumb-empty><div class=icon>⚠️</div><p>이미지 로드 실패</p></div>\'">'+
      '<div class="thumb-actions">'+
        '<button onclick="event.stopPropagation();openThumbModal()">변경</button>'+
        (t.override?'<button class="del" onclick="event.stopPropagation();clearThumbOverride()">삭제</button>':'')+
      '</div>';
  }else{
    box.className='thumb-box';
    box.innerHTML=
      '<div class="thumb-empty">'+
        '<div class="icon">📷</div>'+
        '<p>대표 사진을 선택하세요<br><span style="font-size:11px;color:#BBB">없으면 첫 사진이 자동 사용됩니다</span></p>'+
        '<button class="pick-btn" onclick="event.stopPropagation();openThumbModal()">사진 선택</button>'+
      '</div>';
  }
}

function openThumbModal(){
  const m=document.getElementById('thumbModal');
  const imgs=blocks.filter(b=>b.type==='image');
  renderThumbOptions(imgs);
  switchThumbTab(imgs.length>0?'existing':'upload');
  m.classList.add('show');
}

function closeThumbModal(){document.getElementById('thumbModal').classList.remove('show')}

function switchThumbTab(tab){
  document.getElementById('tabExisting').classList.toggle('active',tab==='existing');
  document.getElementById('tabUpload').classList.toggle('active',tab==='upload');
  document.getElementById('thumbTabExisting').style.display=tab==='existing'?'block':'none';
  document.getElementById('thumbTabUpload').style.display=tab==='upload'?'block':'none';
}

function renderThumbOptions(imgs){
  const grid=document.getElementById('thumbOptions');
  if(imgs.length===0){
    grid.innerHTML='<div style="grid-column:1/-1;text-align:center;padding:30px;color:#888;font-size:13px">아직 추가된 사진이 없어요.<br><span style="font-size:11px;color:#BBB">"새 사진 업로드" 탭으로 이동하거나, 먼저 본문에 사진을 추가하세요</span></div>';
    return;
  }
  grid.innerHTML=imgs.map(b=>{
    const src=b.dataUrl||b.src;
    const cur=b.isThumbnail&&!thumbOverride;
    return '<div class="thumb-option'+(cur?' selected':'')+'" onclick="pickFromBlocks(\''+b.id+'\')">'+
      '<img src="'+src+'" alt="" onerror="this.style.display=\'none\'">'+
      (cur?'<div class="thumb-option-current">⭐ 현재</div>':'')+
    '</div>';
  }).join('');
}

function pickFromBlocks(id){setThumbnail(id);closeThumbModal()}

function clearThumbOverride(){
  if(!confirm('업로드한 대표 사진을 삭제할까요?'))return;
  thumbOverride=null;
  updateThumbPreview();markDirty();
  showStatus('info','대표 사진이 제거되었습니다 (첫 본문 사진이 자동 사용됨)');
}

function setupThumbUpload(){
  const zone=document.getElementById('thumbUploadZone');
  const inp=document.getElementById('thumbFileInput');
  if(!zone||!inp)return;
  zone.addEventListener('click',e=>{if(e.target.tagName!=='INPUT')inp.click()});
  zone.addEventListener('dragover',e=>{e.preventDefault();zone.style.borderColor='#B8956A';zone.style.background='#FFF8F0'});
  zone.addEventListener('dragleave',()=>{zone.style.borderColor='';zone.style.background=''});
  zone.addEventListener('drop',e=>{
    e.preventDefault();
    zone.style.borderColor='';zone.style.background='';
    const f=Array.from(e.dataTransfer.files).find(x=>x.type.startsWith('image/'));
    if(f)handleThumbFile(f);
  });
  inp.addEventListener('change',e=>{
    const f=e.target.files[0];
    if(f)handleThumbFile(f);
    inp.value='';
  });
}

function handleThumbFile(file){
  const r=new FileReader();
  r.onload=e=>{
    thumbOverride={
      file,filename:file.name,dataUrl:e.target.result,
      src:null,uploaded:false,uploadedPath:null
    };
    blocks.forEach(b=>{if(b.type==='image')b.isThumbnail=false});
    renderBlocks();updateThumbPreview();closeThumbModal();markDirty();
    showStatus('success','대표 사진이 설정되었습니다');
  };
  r.readAsDataURL(file);
}

function renderBlocks(){
  const a=document.getElementById('blocks');
  if(blocks.length===0){
    a.innerHTML='<div class="empty">오른쪽 아래 <kbd>＋</kbd> 버튼 또는 위 영역에서 시작하세요.<br><span style="font-size:11px;color:#BBB;display:inline-block;margin-top:8px">단축키: <kbd>Ctrl+Shift+T</kbd> 텍스트 · <kbd>Ctrl+Shift+I</kbd> 사진 · <kbd>Ctrl+S</kbd> 저장</span></div>';
    updateThumbPreview();return;
  }
  a.innerHTML=blocks.map((b,i)=>renderBlock(b,i)).join('');
  blocks.forEach(b=>{
    if(b.type==='text'){
      const el=document.querySelector('#'+b.id+' .text-content');
      if(el){
        el.addEventListener('input',()=>updateTextContent(b.id,el.innerHTML));
        el.addEventListener('paste',e=>{
          e.preventDefault();
          const t=(e.clipboardData||window.clipboardData).getData('text');

async function loadWorksList(){
  const list=document.getElementById('worksList');
  list.innerHTML='<div style="grid-column:1/-1;text-align:center;padding:40px;color:#999">목록 불러오는 중...</div>';
  try{
    const url='https://api.github.com/repos/'+REPO+'/contents/src/content/works?ref='+BRANCH;
    const res=await fetch(url,{headers:{'Authorization':'Bearer '+TOKEN,'Accept':'application/vnd.github.v3+json'}});
    if(!res.ok)throw new Error('HTTP '+res.status);
    const files=await res.json();
    const mds=files.filter(f=>f.name.endsWith('.md')&&!f.name.startsWith('.'));
    if(mds.length===0){
      list.innerHTML='<div style="grid-column:1/-1;text-align:center;padding:40px;color:#999">발행된 글이 없습니다</div>';return;
    }
    const works=await Promise.all(mds.map(async f=>{
      try{
        const r=await fetch(f.url,{headers:{'Authorization':'Bearer '+TOKEN,'Accept':'application/vnd.github.v3+json'}});
        const d=await r.json();
        const bytes=Uint8Array.from(atob(d.content.replace(/\s/g,'')),c=>c.charCodeAt(0));
        const content=new TextDecoder('utf-8').decode(bytes);
        const m=content.match(/^---\n([\s\S]*?)\n---/);
        const meta=m?jsyaml.load(m[1]):{};
        return{file:f,sha:d.sha,meta,content,path:f.path};
      }catch(e){return{file:f,error:e.message}}
    }));
    works.sort((a,b)=>{
      const da=a.meta?.date?new Date(a.meta.date).getTime():0;
      const db=b.meta?.date?new Date(b.meta.date).getTime():0;
      return db-da;
    });
    list.innerHTML=works.map(w=>{
      if(w.error)return '<div class="work-card" style="opacity:.5"><div class="work-card-info"><div class="work-card-title">읽기 실패</div><div class="work-card-meta">'+w.file.name+'</div></div></div>';
      const t=w.meta.title||'(제목 없음)';
      const loc=w.meta.location||'';
      const dt=w.meta.date?new Date(w.meta.date).toLocaleDateString('ko-KR'):'';
      const thumb=w.meta.thumbnail||'';
      const thumbStyle=thumb?'background-image:url(\''+thumb+'\')':'';
      return '<div class="work-card" onclick="selectWork(\''+w.path+'\')">'+
        '<div class="work-card-thumb" style="'+thumbStyle+'"></div>'+
        '<div class="work-card-info">'+
          '<div class="work-card-title">'+escapeHtml(t)+'</div>'+
          '<div class="work-card-meta">'+escapeHtml(loc)+' · '+dt+'</div>'+
        '</div>'+
      '</div>';
    }).join('');
    window._worksCache={};
    works.forEach(w=>{if(!w.error)window._worksCache[w.path]=w});
  }catch(e){
    list.innerHTML='<div style="grid-column:1/-1;text-align:center;padding:40px;color:#C62828">목록 불러오기 실패: '+e.message+'</div>';
  }
}


function loadIntoEditor(w){
  const m=w.meta;
  document.getElementById('title').value=m.title||'';
  document.getElementById('location').value=m.location||'';
  document.getElementById('category').value=m.category||'주거';
  let dateStr='';
  if(m.date){
    if(m.date instanceof Date)dateStr=m.date.toISOString().split('T')[0];
    else if(typeof m.date==='string')dateStr=m.date.split('T')[0];
  }
  document.getElementById('date').value=dateStr;
  document.getElementById('area').value=m.area||'';
  document.getElementById('duration').value=m.duration||'1일 완공';
  document.getElementById('specs').value=m.specs||'';
  
  blocks=[];blockIdCounter=0;thumbOverride=null;
  const thumb=m.thumbnail;
  let thumbMatched=false;
  if(Array.isArray(m.blocks)){
    for(const b of m.blocks){
      if(b.type==='text'){
        blocks.push({id:nextId(),type:'text',content:mdToHtml(b.content||'')});
      }else if(b.type==='image'){
        const filename=(b.src||'').split('/').pop()||'image';
        const isThumb=thumb===b.src;
        if(isThumb)thumbMatched=true;
        blocks.push({
          id:nextId(),type:'image',src:b.src,dataUrl:b.src,
          filename,caption:b.caption||'',
          uploaded:true,existing:true,uploadedPath:b.src,
          isThumbnail:isThumb,file:null
        });
      }
    }
  }
  if(thumb&&!thumbMatched){
    thumbOverride={
      filename:thumb.split('/').pop()||'대표 사진',
      src:thumb,uploaded:true,uploadedPath:thumb,dataUrl:thumb,file:null
    };
  }
  editingPath=w.path;
  editingSha=w.sha;
  document.getElementById('editingBanner').style.display='flex';
  document.getElementById('editingTitle').textContent=m.title||'(제목 없음)';
  renderBlocks();updateSummary();updateThumbPreview();markDirty();
}


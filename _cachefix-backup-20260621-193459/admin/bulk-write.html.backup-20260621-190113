// ========== 마크다운/HTML 변환 ==========
function mdToHtml(md){
  if(!md)return '';
  let h=md;
  h=h.replace(/\\\*/g,'\u0001').replace(/\\_/g,'\u0002');
  h=h.replace(/\*\*([^*\n]+?)\*\*/g,'<strong>$1</strong>');
  h=h.replace(/(^|[^*])\*([^*\n]+?)\*(?!\*)/g,'$1<em>$2</em>');
  h=h.replace(/^### (.+)$/gm,'<h4>$1</h4>');
  h=h.replace(/^## (.+)$/gm,'<h3>$1</h3>');
  h=h.replace(/^# (.+)$/gm,'<h2>$1</h2>');
  h=h.replace(/\u0001/g,'*').replace(/\u0002/g,'_');
  const parts=h.split(/\n\s*\n/);
  return parts.map(p=>{
    p=p.trim();if(!p)return '';
    if(/^<(h[1-6]|ul|ol|li|blockquote)/i.test(p))return p;
    return '<p>'+p.replace(/\n/g,'<br>')+'</p>';
  }).filter(Boolean).join('');
}

function htmlToMd(html){
  if(!html)return '';
  let t=html;
  t=t.replace(/<div[^>]*>/gi,'<p>').replace(/<\/div>/gi,'</p>');
  t=t.replace(/<h2[^>]*>([\s\S]*?)<\/h2>/gi,'\n\n# $1\n\n');
  t=t.replace(/<h3[^>]*>([\s\S]*?)<\/h3>/gi,'\n\n## $1\n\n');
  t=t.replace(/<h4[^>]*>([\s\S]*?)<\/h4>/gi,'\n\n### $1\n\n');
  t=t.replace(/<(strong|b)[^>]*>([\s\S]*?)<\/\1>/gi,'**$2**');
  t=t.replace(/<(em|i)[^>]*>([\s\S]*?)<\/\1>/gi,'*$2*');
  t=t.replace(/<u[^>]*>([\s\S]*?)<\/u>/gi,'$1');
  t=t.replace(/<br\s*\/?>/gi,'\n');
  t=t.replace(/<p[^>]*>/gi,'').replace(/<\/p>/gi,'\n\n');
  t=t.replace(/<font([^>]*color\s*=\s*["']?([^"'\s>]+)["']?[^>]*)>([\s\S]*?)<\/font>/gi,'<span style="color:$2">$3</span>');
  t=t.replace(/<span[^>]*>(\s*)<\/span>/gi,'$1');
  const tx=document.createElement('div');
  tx.innerHTML=t;
  let result=tx.innerHTML;
  result=result.replace(/\n{3,}/g,'\n\n').trim();
  return result;
}

// ========== YAML ==========
function yamlString(s){
  if(s===null||s===undefined)return '""';
  s=String(s);
  return '"'+s.replace(/\\/g,'\\\\').replace(/"/g,'\\"').replace(/\n/g,'\\n').replace(/\r/g,'\\r').replace(/\t/g,'\\t')+'"';
}

function buildYaml(meta,blockArr,thumb){
  let y='---\n';
  y+='title: '+yamlString(meta.title)+'\n';
  y+='location: '+yamlString(meta.location)+'\n';
  y+='category: '+yamlString(meta.category)+'\n';
  if(meta.date)y+='date: '+meta.date+'\n';
  if(thumb)y+='thumbnail: '+yamlString(thumb)+'\n';
  if(meta.specs)y+='specs: '+yamlString(meta.specs)+'\n';
  if(meta.duration)y+='duration: '+yamlString(meta.duration)+'\n';
  if(meta.area)y+='area: '+meta.area+'\n';
  y+='featured: false\n';
  y+='blocks:\n';
  for(const b of blockArr){
    if(b.type==='text'){
      const md=htmlToMd(b.content||'');
      y+='  - type: text\n';
      y+='    content: '+yamlString(md)+'\n';
    }else if(b.type==='image'){
      y+='  - type: image\n';
      y+='    src: '+yamlString(b.src||b.uploadedPath)+'\n';
      if(b.caption)y+='    caption: '+yamlString(b.caption)+'\n';
    }
  }
  y+='---\n';
  return y;
}


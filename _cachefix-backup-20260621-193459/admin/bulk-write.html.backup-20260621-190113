// 모든 응답에 대해 엄격한 검증
async function ghGetFile(path){
  const url='https://api.github.com/repos/'+REPO+'/contents/'+encodeURIComponent(path).replace(/%2F/g,'/')+'?ref='+BRANCH+'&t='+Date.now(); // 캐시 방지
  const res=await fetch(url,{
    headers:{'Authorization':'Bearer '+TOKEN,'Accept':'application/vnd.github.v3+json','Cache-Control':'no-cache'}
  });
  if(res.status===404)return null;
  if(!res.ok){
    const txt=await res.text();
    throw new Error('GET 실패 ['+res.status+']: '+txt.slice(0,300));
  }
  const data=await res.json();
  if(!data||!data.sha)throw new Error('GET 응답이 비정상입니다 (sha 누락)');
  return data;
}

// PUT 후 응답 검증 강화
async function ghPutFile(path,content,sha,message){
  const url='https://api.github.com/repos/'+REPO+'/contents/'+encodeURIComponent(path).replace(/%2F/g,'/');
  const body={message,content,branch:BRANCH};
  if(sha)body.sha=sha;
  
  const res=await fetch(url,{
    method:'PUT',
    headers:{
      'Authorization':'Bearer '+TOKEN,
      'Accept':'application/vnd.github.v3+json',
      'Content-Type':'application/json'
    },
    body:JSON.stringify(body)
  });
  
  const responseText=await res.text();
  
  if(!res.ok){
    let detail=responseText.slice(0,500);
    try{
      const j=JSON.parse(responseText);
      if(j.message)detail=j.message;
      if(j.errors)detail+=' / '+JSON.stringify(j.errors);
    }catch(e){}
    throw new Error('PUT 실패 ['+res.status+'] '+detail);
  }
  
  let result;
  try{result=JSON.parse(responseText)}
  catch(e){throw new Error('PUT 응답 파싱 실패: '+responseText.slice(0,200))}
  
  // 응답 검증: commit SHA가 있어야 진짜 저장된 것
  if(!result.commit||!result.commit.sha){
    throw new Error('PUT 응답에 commit 정보 없음 — 저장이 실패했을 수 있습니다. 응답: '+responseText.slice(0,300));
  }
  if(!result.content||!result.content.sha){
    throw new Error('PUT 응답에 파일 정보 없음 — 저장이 실패했을 수 있습니다.');
  }
  
  return result;
}

// 저장 후 실제로 파일이 존재하는지 GET으로 재확인
async function verifyFileExists(path,expectedContent){
  // GitHub Contents API는 약간의 지연이 있을 수 있어 짧게 대기
  await new Promise(r=>setTimeout(r,1500));
  const data=await ghGetFile(path);
  if(!data)throw new Error('검증 실패: 파일이 GitHub에 존재하지 않습니다');
  // base64 디코드해서 내용 비교 (앞부분만)
  try{
    const decoded=new TextDecoder('utf-8').decode(
      Uint8Array.from(atob(data.content.replace(/\s/g,'')),c=>c.charCodeAt(0))
    );
    if(expectedContent&&decoded.slice(0,200)!==expectedContent.slice(0,200)){
      throw new Error('검증 실패: 저장된 내용이 보낸 내용과 다릅니다');
    }
  }catch(e){
    if(e.message.startsWith('검증 실패'))throw e;
    // 디코드 실패는 무시 (파일 존재만 확인되면 OK)
  }
  return data;
}

function fileToBase64(file){
  return new Promise((resolve,reject)=>{
    const r=new FileReader();
    r.onload=()=>{const s=r.result;const i=s.indexOf(',');resolve(s.slice(i+1))};
    r.onerror=()=>reject(new Error('파일 읽기 실패'));
    r.readAsDataURL(file);
  });
}

function utf8ToBase64(str){
  const bytes=new TextEncoder().encode(str);
  let bin='';for(const b of bytes)bin+=String.fromCharCode(b);
  return btoa(bin);
}

function safeName(name){return name.replace(/[^\w.\-가-힣ㄱ-ㅎㅏ-ㅣ]/g,'_')}

function slugify(s){
  return String(s||'').toLowerCase()
    .replace(/[^\w가-힣ㄱ-ㅎㅏ-ㅣ\s-]/g,'').trim()
    .replace(/\s+/g,'-').slice(0,80);
}


let publishing=false;
async function publish(){
  if(publishing)return;
  
  // 토큰 권한 사전 체크
  if(!TOKEN_VERIFIED){
    showStatus('error','⚠️ GitHub 쓰기 권한이 확인되지 않았습니다. 페이지를 새로고침하거나 CMS에 다시 로그인하세요.');
    return;
  }
  
  const meta=getMeta();
  if(!meta.title.trim())return showStatus('error','제목을 입력해주세요');
  if(!meta.location.trim())return showStatus('error','지역을 입력해주세요');
  if(!meta.date)return showStatus('error','시공일을 선택해주세요');
  if(blocks.length===0)return showStatus('error','텍스트나 사진 블록을 1개 이상 추가해주세요');
  
  publishing=true;
  document.getElementById('pubBtn').disabled=true;
  document.getElementById('pubBtn2').disabled=true;
  
  const modal=document.getElementById('pubModal');
  const log=document.getElementById('pubLog');
  const title=document.getElementById('pubTitle');
  const footer=document.getElementById('pubFooter');
  const close=document.getElementById('pubClose');
  const link=document.getElementById('pubLink');
  const verifyEl=document.getElementById('verifyResult');
  log.innerHTML='';
  verifyEl.innerHTML='';
  title.textContent=editingPath?'수정 중...':'발행 중...';
  footer.style.display='none';
  close.style.display='none';
  modal.classList.add('show');
  
  const addLog=(t,cls)=>{
    const ts=new Date().toLocaleTimeString();
    const line=document.createElement('div');
    if(cls)line.className=cls;
    line.textContent='['+ts+'] '+t;
    log.appendChild(line);
    log.scrollTop=log.scrollHeight;
  };
  
  let savedPath=null;
  let savedCommitSha=null;
  
  try{
    addLog((editingPath?'수정':'발행')+' 시작: '+meta.title,'info');
    
    // 1. 새 이미지 업로드
    const newImages=blocks.filter(b=>b.type==='image'&&!b.existing&&!b.uploaded&&b.file);
    if(newImages.length>0){
      addLog('새 사진 '+newImages.length+'장 업로드 시작...');
      for(let i=0;i<newImages.length;i++){
        const b=newImages[i];
        b.uploading=true;b.progress=0;renderBlocks();
        try{
          const ts=Date.now();
          const sn=safeName(b.filename);
          const remoteName=ts+'_'+i+'_'+sn;
          const remotePath='public/uploads/'+remoteName;
          const b64=await fileToBase64(b.file);
          addLog('사진 '+(i+1)+'/'+newImages.length+' 업로드: '+sn);
          const result=await ghPutFile(remotePath,b64,null,'Upload image: '+remoteName);
          b.uploaded=true;b.uploading=false;b.progress=100;
          b.uploadedPath='/uploads/'+remoteName;
          b.src=b.uploadedPath;
          renderBlocks();
          addLog('✓ 업로드됨 (commit: '+result.commit.sha.slice(0,7)+')','ok');
        }catch(e){
          b.uploading=false;renderBlocks();
          throw new Error('사진 업로드 실패 ['+b.filename+']: '+e.message);
        }
      }
      addLog('모든 사진 업로드 완료','ok');
    }
    
    // 1-B. 별도 대표 사진 업로드
    if(thumbOverride&&!thumbOverride.uploaded&&thumbOverride.file){
      addLog('대표 사진 업로드 중...');
      try{
        const ts=Date.now();
        const sn=safeName(thumbOverride.filename||'thumbnail.jpg');
        const remoteName=ts+'_thumb_'+sn;
        const remotePath='public/uploads/'+remoteName;
        const b64=await fileToBase64(thumbOverride.file);
        const result=await ghPutFile(remotePath,b64,null,'Upload thumbnail: '+remoteName);
        thumbOverride.uploaded=true;
        thumbOverride.uploadedPath='/uploads/'+remoteName;
        thumbOverride.src=thumbOverride.uploadedPath;
        addLog('✓ 대표 사진 업로드 완료 (commit: '+result.commit.sha.slice(0,7)+')','ok');
      }catch(e){throw new Error('대표 사진 업로드 실패: '+e.message)}
    }
    
    // 2. thumbnail 결정
    let thumb='';
    if(thumbOverride&&(thumbOverride.uploadedPath||thumbOverride.src)){
      thumb=thumbOverride.uploadedPath||thumbOverride.src;
    }else{
      const starred=blocks.find(b=>b.type==='image'&&b.isThumbnail);
      const firstImg=blocks.find(b=>b.type==='image');
      thumb=(starred?.src||starred?.uploadedPath)||(firstImg?.src||firstImg?.uploadedPath)||'';
    }
    addLog('대표 사진: '+(thumb||'(없음)'));
    
    // 3. YAML
    addLog('마크다운 생성 중...');
    const yaml=buildYaml(meta,blocks,thumb);
    addLog('생성 완료 ('+yaml.length+'자)');
    
    // 4. 경로 결정 + 최신 SHA 강제 fetch
    let path;
    let freshSha=null; // editingSha 캐시 의존 X — 매번 새로 fetch
    
    if(editingPath){
      path=editingPath;
      addLog('수정 모드: 최신 SHA 확인 중...');
      const existing=await ghGetFile(path);
      if(!existing)throw new Error('수정하려는 파일이 GitHub에 없습니다: '+path);
      freshSha=existing.sha;
      addLog('현재 SHA: '+freshSha.slice(0,7),'info');
    }else{
      const slug=slugify(meta.title);
      path='src/content/works/'+meta.date+'-'+slug+'.md';
      addLog('저장 경로: '+path);
      addLog('기존 파일 확인 중...');
      const existing=await ghGetFile(path);
      if(existing){
        if(!confirm('같은 날짜·제목의 글이 이미 있어요. 덮어쓸까요?\n\n경로: '+path)){
          throw new Error('사용자가 덮어쓰기를 취소함');
        }
        freshSha=existing.sha;
        addLog('기존 글 발견 → 덮어쓰기 (SHA: '+freshSha.slice(0,7)+')','warn');
      }else{
        addLog('새 파일 생성','info');
      }
    }
    
    // 5. PUT (응답 검증 포함)
    addLog('GitHub에 저장 중...');
    const b64=utf8ToBase64(yaml);
    const putResult=await ghPutFile(path,b64,freshSha,(editingPath?'Update':'Publish')+' work: '+meta.title);
    savedCommitSha=putResult.commit.sha;
    savedPath=path;
    addLog('✓ PUT 응답 OK (commit: '+savedCommitSha.slice(0,7)+')','ok');
    
    // 6. ⭐ 핵심: 실제로 저장됐는지 GET으로 검증
    addLog('','');
    addLog('🔍 저장 검증 중... (1.5초 대기 후 GET)','info');
    try{
      const verified=await verifyFileExists(path,yaml);
      addLog('✓ 검증 성공: 파일이 GitHub에 실존합니다','ok');
      addLog('  파일 SHA: '+verified.sha.slice(0,7),'ok');
      addLog('  크기: '+verified.size+' bytes','ok');
      verifyEl.className='verify-result ok';
      verifyEl.innerHTML='✓ <strong>검증 완료</strong> — GitHub에 정상 저장됨<br>'+
        '경로: '+path+'<br>'+
        'Commit: '+savedCommitSha.slice(0,7)+' · File SHA: '+verified.sha.slice(0,7);
    }catch(verifyErr){
      // 검증 실패는 치명적이지만 PUT 자체는 성공했을 수도 있음
      addLog('⚠️ 검증 실패: '+verifyErr.message,'err');
      addLog('  PUT은 성공했지만 GET으로 확인이 안됨 — 잠시 후 다시 확인하세요','warn');
      verifyEl.className='verify-result fail';
      verifyEl.innerHTML='⚠️ <strong>검증 실패</strong> — PUT은 성공했으나 GET 확인 실패.<br>'+
        verifyErr.message+'<br>'+
        '잠시 후 사이트에서 직접 확인해주세요.';
      // 검증 실패해도 일단 발행은 계속 진행 (PUT은 성공했으니)
    }
    
    addLog('','');
    addLog('사이트 빌드 대기 중... (Astro 빌드 후 2-3분 내 반영)','info');
    addLog('✓ '+(editingPath?'수정':'발행')+' 완료!','ok');
    
    // 7. 성공 → 임시저장 삭제
    localStorage.removeItem(DRAFT_KEY);
    setSaveState('saved');
    isDirty=false;
    
    title.textContent='✓ '+(editingPath?'수정':'발행')+' 완료';
    const slug=path.replace('src/content/works/','').replace('.md','');
    link.href='/works/'+encodeURIComponent(slug)+'/';
    footer.style.display='flex';
    close.style.display='block';
  }catch(e){
    addLog('','');
    addLog('✗ 실패: '+e.message,'err');
    if(savedPath){
      addLog('','');
      addLog('참고: PUT은 시도됐습니다. 경로: '+savedPath,'warn');
      if(savedCommitSha)addLog('Commit SHA: '+savedCommitSha,'warn');
    }
    title.textContent='✗ 실패';
    verifyEl.className='verify-result fail';
    verifyEl.innerHTML='✗ <strong>발행 실패</strong><br>'+e.message+'<br><br>'+
      '<small>해결 방법:<br>'+
      '1. 네트워크 연결 확인<br>'+
      '2. CMS에 다시 로그인 (토큰 갱신)<br>'+
      '3. GitHub Repository 권한 확인<br>'+
      '4. 위 로그를 캡처해서 개발자에게 전달</small>';
    close.style.display='block';
    document.getElementById('pubBtn').disabled=false;
    document.getElementById('pubBtn2').disabled=false;
  }finally{
    publishing=false;
  }
}

function closePubModal(){
  document.getElementById('pubModal').classList.remove('show');
  document.getElementById('pubBtn').disabled=!TOKEN_VERIFIED;
  document.getElementById('pubBtn2').disabled=!TOKEN_VERIFIED;
}

// ========== 초기화 ==========
if(TOKEN){
  checkDraft();
  updateSummary();
  setupThumbUpload();
  updateThumbPreview();
}
</script>
</body>
</html>

---
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "플로릭스 스튜디오 | 콘크리트 폴리싱 전문",
  description = "콘크리트의 새로운 기준. 1일 완공, 원하는 색상과 규사로 시공하는 콘크리트 폴리싱 전문 스튜디오. 전국 시공 · 24시간 상담.",
  image = "/og-image.svg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "플로릭스 스튜디오",
  "alternateName": "FLORIX STUDIO",
  "description": description,
  "url": "https://florixstudio.co.kr",
  "telephone": "+82-10-8930-2266",
  "email": "contact@florixstudio.co.kr",
  "image": new URL(image, Astro.site).toString(),
  "areaServed": { "@type": "Country", "name": "대한민국" },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    "opens": "00:00",
    "closes": "23:59",
    "description": "24시간 상담 가능"
  },
  "sameAs": [
    "https://blog.naver.com/florix_studios",
    "https://instagram.com/florix_studios",
    "https://pf.kakao.com/_florixstudio"
  ]
};
---

<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="color-scheme" content="light only" />
    <meta name="theme-color" content="#EFE7D8" />
    <meta name="supported-color-schemes" content="light" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="콘크리트 폴리싱, 콘크리트 광택, 바닥 폴리싱, 콘크리트 연마, 1일 양생, 양생 시공, 카페 바닥, 주택 바닥, 상업공간 바닥, 플로릭스 스튜디오, FLORIX STUDIO" />
    <meta name="author" content="플로릭스 스튜디오" />
    <meta name="robots" content="index, follow" />
    <meta name="Yeti" content="index, follow" />
    <meta name="naver-site-verification" content="41ea7350c15eb5579261ea35cf371c22a52fb617" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site).toString()} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content="플로릭스 스튜디오" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site).toString()} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  </head>
  <body>
    <slot />
  </body>
</html>
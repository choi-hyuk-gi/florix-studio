---
import { getCollection } from 'astro:content';

const allWorks = await getCollection('works');
const recentWorks = allWorks
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

{recentWorks.length > 0 && (
  <section class="bg-bg px-6 lg:px-12 py-32 border-t border-line">
    <div class="max-w-7xl mx-auto">

      <header class="flex flex-col md:flex-row md:items-end md:justify-between gap-8 mb-20">
        <div>
          <div class="flex items-center gap-3 mb-6">
            <div class="w-8 h-px bg-accent"></div>
            <span class="text-[11px] font-bold tracking-[0.3em] uppercase text-accent">Recent Work</span>
          </div>
          <h2 class="text-4xl md:text-6xl font-black text-text leading-[0.95] tracking-[-0.045em]">
            선별된 공간들.
          </h2>
          <p class="mt-6 text-mood text-base max-w-xl leading-relaxed">
            완공일 기준 가장 최근의 작업입니다. 각 공간은 색상·규사·마감 모두 다르게 시공됩니다.
          </p>
        </div>
        <a href="/works/" class="shrink-0 text-sm text-text border-b border-text hover:border-accent hover:text-accent transition-colors pb-1 self-start md:self-end">
          전체 시공 사례 →
        </a>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-x-8 gap-y-16">
        {recentWorks.map((work, i) => (
          <a href={`/works/${work.id}/`} class="group block">
            <div class="relative aspect-[4/5] overflow-hidden bg-gradient-to-br from-[#D8CDB4] via-[#C9BCA0] to-[#B8AB8E] mb-5">
              <div class="absolute inset-0 flex items-center justify-center opacity-30 group-hover:opacity-50 transition-opacity">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" class="text-text/40">
                  <rect x="3" y="3" width="18" height="18" rx="2" />
                  <circle cx="8.5" cy="8.5" r="1.5" />
                  <polyline points="21 15 16 10 5 21" />
                </svg>
              </div>
              <div class="absolute top-4 left-4">
                <span class="text-[10px] font-bold tracking-[0.2em] uppercase text-text/60 bg-bg/80 px-3 py-1.5">
                  {work.data.category}
                </span>
              </div>
              <div class="absolute bottom-4 right-4 text-[10px] tracking-[0.2em] text-text/40 font-mono">
                No. {String(i + 1).padStart(3, '0')}
              </div>
            </div>

            <div>
              <h3 class="text-lg md:text-xl font-bold text-text leading-tight tracking-[-0.02em] group-hover:text-accent transition-colors">
                {work.data.title}
              </h3>
              <div class="mt-2 flex items-center gap-3 text-sm text-mood">
                <span>{work.data.location}</span>
                {work.data.area && (
                  <>
                    <span class="text-line">/</span>
                    <span>{work.data.area}㎡</span>
                  </>
                )}
              </div>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>
)}
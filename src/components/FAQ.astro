    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="group border border-border bg-bg hover:border-border-strong transition-colors">
          <summary class="flex items-center justify-between px-6 py-5 cursor-pointer text-[15px] font-bold text-text list-none">
            <span>{faq.q}</span>
            <span class="text-accent ml-4 text-2xl leading-none transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="px-6 pb-6 text-[14px] text-muted leading-[1.8] border-t border-border pt-5">{faq.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

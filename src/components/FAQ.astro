<section id="faq" class="px-6 md:px-12 py-20 md:py-28 border-t border-border bg-surface">
  <div class="max-w-3xl mx-auto">
    <div class="mb-16 md:mb-20 text-center">
      <div class="text-[11px] tracking-[0.32em] text-accent font-bold mb-5">FAQ</div>

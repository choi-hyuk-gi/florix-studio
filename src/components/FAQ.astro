---
const faqs = [
  { q: "시공 시간은 얼마나 걸리나요?", a: "보통 20~50평 기준 하루(6~8시간) 안에 완료됩니다. 면적과 현장 상태에 따라 차이가 있으니 견적 시 안내드립니다." },
  { q: "전국 어디든 시공이 가능한가요?", a: "네, 제주도를 포함한 전국 모든 지역에서 시공합니다. 원거리는 출장비가 추가될 수 있습니다." },
  { q: "기존 타일이나 장판 위에 바로 시공할 수 있나요?", a: "기존 마감재 종류와 상태에 따라 가능 여부가 달라집니다. 현장 방문 견적 시 확인 후 안내드립니다." },
  { q: "견적은 어떻게 받나요?", a: "카카오톡 채널 또는 전화(010-8930-2266)로 면적과 사진을 보내주시면 빠르게 안내드립니다." },
  { q: "시공 후 유지 관리는 어떻게 하나요?", a: "완공 후 일반 중성 세제로 물청소 가능합니다. 3~5년 주기로 리코팅을 권장드립니다." },
];
---

<section id="faq" class="px-6 md:px-12 py-20 md:py-28 border-t border-border bg-surface">
  <div class="max-w-3xl mx-auto">
    <div class="mb-16 md:mb-20 text-center">
      <div class="text-[11px] tracking-[0.32em] text-accent font-bold mb-5">FAQ</div>
      <h2 class="text-[36px] md:text-[56px] font-black tracking-[-0.035em] text-text leading-[1.05]">
        자주 묻는 질문
      </h2>
    </div>

    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="group border border-border bg-bg hover:border-border-strong transition-colors">
          <summary class="flex items-center justify-between px-6 py-5 cursor-pointer text-[15px] font-bold text-text list-none">
            <span>{faq.q}</span>
            <span class="text-accent ml-4 text-2xl leading-none transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="px-6 pb-6 text-[14px] text-muted leading-[1.8] border-t border-border pt-5">{faq.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

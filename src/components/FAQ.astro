---
import { getCollection, render } from 'astro:content';

const faqs = (await getCollection('faqs')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<section id="faq" class="bg-bg px-6 lg:px-12 py-32 border-t border-line">
  <div class="max-w-4xl mx-auto">

    <header class="text-center mb-20">
      <div class="inline-flex items-center gap-3 mb-6">
        <div class="w-8 h-px bg-accent"></div>
        <span class="text-[11px] font-bold tracking-[0.3em] uppercase text-accent">FAQ</span>
        <div class="w-8 h-px bg-accent"></div>
      </div>
      <h2 class="text-4xl md:text-6xl font-black text-text leading-[0.95] tracking-[-0.045em]">
        자주 묻는 질문
      </h2>
    </header>

    <div class="space-y-4">
      {faqs.map(async (faq) => {
        const { Content } = await render(faq);
        return (
          <details class="group bg-line/40 hover:bg-line/60 transition-colors">
            <summary class="cursor-pointer list-none flex items-center justify-between gap-4 px-6 py-5">
              <span class="text-base md:text-lg font-bold text-text tracking-[-0.02em]">
                {faq.data.question}
              </span>
              <span class="text-2xl text-accent shrink-0 group-open:rotate-45 transition-transform">+</span>
            </summary>
            <div class="px-6 pb-6 text-mood text-sm md:text-base leading-relaxed">
              <Content />
            </div>
          </details>
        );
      })}
    </div>

  </div>
</section>
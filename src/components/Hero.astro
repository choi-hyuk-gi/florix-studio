---
import { getEntry } from 'astro:content';

const settings = await getEntry('settings', 'site');
const s = settings?.data ?? {
  heroBadge: 'CONCRETE POLISHING STUDIO · SINCE 2026',
  heroTitle: '콘크리트의',
  heroTitleAccent: '새로운 기준.',
  heroSubtitle: '1일 완공. 원하는 색상, 원하는 규사.',
  heroSubtitle2: '시공이 아닌 작품으로 마감합니다.',
  heroImage: '',
  heroSlides: [],
  recentWorkLabel: 'FEATURED WORK',
  recentWorkNumber: 'No. 001',
};

// 슬라이드 목록
const slides = (s.heroSlides && s.heroSlides.length > 0)
  ? s.heroSlides
  : (s.heroImage ? [{ image: s.heroImage, alt: '시공 사례' }] : []);
---

<section class="grid md:grid-cols-2">

  <div class="bg-bg flex flex-col justify-center order-2 md:order-1 px-6 md:px-12 lg:px-16 py-16 md:py-24">
    <div class="inline-flex items-center gap-3 mb-6 md:mb-8">
      <div class="w-12 h-px bg-accent"></div>
      <span class="text-[10px] md:text-[11px] font-bold tracking-[0.3em] uppercase text-accent">{s.heroBadge}</span>
    </div>

    <h1 class="text-[44px] sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl font-black leading-[0.95] tracking-[-0.045em] text-text mb-6 md:mb-8">
      {s.heroTitle}<br />
      <span class="font-light italic text-accent">{s.heroTitleAccent}</span>
    </h1>

    <p class="text-sm md:text-base lg:text-lg text-text/80 leading-relaxed mb-8 md:mb-12 max-w-md">
      {s.heroSubtitle}<br />
      {s.heroSubtitle2}
    </p>

    <div class="flex flex-wrap gap-3 md:gap-4">
      <a href="#cta" class="inline-flex items-center gap-2 bg-text text-bg px-6 md:px-7 py-3.5 md:py-4 text-sm font-bold tracking-wider hover:bg-accent transition-colors">
        무료 견적 받기 →
      </a>
      <a href="#process" class="inline-flex items-center gap-2 border border-text text-text px-6 md:px-7 py-3.5 md:py-4 text-sm font-bold tracking-wider hover:border-accent hover:text-accent transition-colors">
        시공 과정 보기
      </a>
    </div>
  </div>

  <div class="relative bg-gradient-to-br from-[#C9BCA0] via-[#BCAD8E] to-[#A89878] overflow-hidden hero-slideshow order-1 md:order-2 aspect-square md:aspect-auto md:min-h-[700px]">
    <div class="absolute top-4 md:top-6 left-4 md:left-6 z-30 text-[10px] md:text-[11px] tracking-[0.3em] text-white/90 font-bold drop-shadow">
      / {s.recentWorkLabel}
    </div>
    <div class="absolute top-4 md:top-6 right-4 md:right-6 z-30 text-[10px] md:text-[11px] tracking-[0.3em] text-white/90 font-bold drop-shadow">
      {s.recentWorkNumber}
    </div>

    {slides.length > 0 ? (
      <>
        {slides.map((slide, i) => (
          <div
            class={`slide absolute inset-0 transition-opacity duration-1000 ease-in-out ${i === 0 ? "opacity-100" : "opacity-0"}`}
            data-slide-index={i}
          >
            <img src={slide.image} alt={slide.alt ?? "시공 사례"} class="w-full h-full object-contain p-4 md:p-8" />
          </div>
        ))}

        {slides.length > 1 && (
          <div class="absolute bottom-4 md:bottom-6 left-1/2 -translate-x-1/2 z-30 flex gap-2 slide-dots">
            {slides.map((_, i) => (
              <button
                type="button"
                aria-label={`슬라이드 ${i + 1}`}
                data-dot-index={i}
                class={`slide-dot w-2 h-2 rounded-full transition-all ${i === 0 ? "bg-white w-6" : "bg-white/50"}`}
              />
            ))}
          </div>
        )}
      </>
    ) : (
      <div class="absolute inset-0 flex items-center justify-center">
        <div class="text-center">
          <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" class="text-text/30 mx-auto mb-4">
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <circle cx="8.5" cy="8.5" r="1.5" />
            <polyline points="21 15 16 10 5 21" />
          </svg>
          <div class="text-[10px] tracking-[0.3em] text-text/40 font-bold">PHOTO COMING SOON</div>
        </div>
      </div>
    )}
  </div>

</section>

<script is:inline>
  (function() {
    const container = document.querySelector(".hero-slideshow");
    if (!container) return;
    const slides = container.querySelectorAll(".slide");
    const dots = container.querySelectorAll(".slide-dot");
    if (slides.length <= 1) return;

    let current = 0;
    let timer = null;
    let paused = false;

    function goTo(idx) {
      slides.forEach(function(s, i) {
        s.style.opacity = (i === idx) ? "1" : "0";
      });
      dots.forEach(function(d, i) {
        if (i === idx) {
          d.classList.remove("bg-white/50");
          d.classList.add("bg-white", "w-6");
        } else {
          d.classList.remove("bg-white", "w-6");
          d.classList.add("bg-white/50");
        }
      });
      current = idx;
    }

    function next() {
      if (paused) return;
      goTo((current + 1) % slides.length);
    }

    function start() {
      if (timer) clearInterval(timer);
      timer = setInterval(next, 4000);
    }

    dots.forEach(function(dot, i) {
      dot.addEventListener("click", function() {
        goTo(i);
        start();
      });
    });

    container.addEventListener("mouseenter", function() { paused = true; });
    container.addEventListener("mouseleave", function() { paused = false; });

    start();
  })();
</script>
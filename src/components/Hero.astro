---
import { getEntry } from 'astro:content';

const settings = await getEntry('settings', 'site');
const s = settings?.data ?? {
  heroBadge: 'CONCRETE POLISHING STUDIO · SINCE 2026',
  heroTitle: '콘크리트의',
  heroTitleAccent: '새로운 기준.',
  heroSubtitle: '1일 완공. 원하는 색상, 원하는 규사.',
  heroSubtitle2: '시공이 아닌 작품으로 마감합니다.',
  heroImage: '',
  recentWorkLabel: 'FEATURED WORK',
  recentWorkNumber: 'No. 001',
};
---

<section class="grid md:grid-cols-2 min-h-[600px] md:min-h-[700px]">

  <div class="bg-bg flex flex-col justify-end px-6 md:px-12 lg:px-16 py-20 md:py-24">
    <div class="inline-flex items-center gap-3 mb-8">
      <div class="w-12 h-px bg-accent"></div>
      <span class="text-[11px] font-bold tracking-[0.3em] uppercase text-accent">{s.heroBadge}</span>
    </div>

    <h1 class="text-5xl md:text-7xl lg:text-8xl font-black leading-[0.95] tracking-[-0.045em] text-text mb-8">
      {s.heroTitle}<br />
      <span class="font-light italic text-accent">{s.heroTitleAccent}</span>
    </h1>

    <p class="text-base md:text-lg text-text/80 leading-relaxed mb-12 max-w-md">
      {s.heroSubtitle}<br />
      {s.heroSubtitle2}
    </p>

    <div class="flex flex-wrap gap-4">
      <a href="#cta" class="inline-flex items-center gap-2 bg-text text-bg px-7 py-4 text-sm font-bold tracking-wider hover:bg-accent transition-colors">
        무료 견적 받기 →
      </a>
      <a href="#process" class="inline-flex items-center gap-2 border border-text text-text px-7 py-4 text-sm font-bold tracking-wider hover:border-accent hover:text-accent transition-colors">
        시공 과정 보기
      </a>
    </div>
  </div>

  <div class="relative bg-gradient-to-br from-[#C9BCA0] via-[#BCAD8E] to-[#A89878] overflow-hidden">
    <div class="absolute top-6 left-6 z-10 text-[11px] tracking-[0.3em] text-text/70 font-bold">
      / {s.recentWorkLabel}
    </div>
    <div class="absolute top-6 right-6 z-10 text-[11px] tracking-[0.3em] text-text/70 font-bold">
      {s.recentWorkNumber}
    </div>

    {s.heroImage && s.heroImage !== "" ? (
      <img src={s.heroImage} alt="시공 사례" class="w-full h-full object-cover" />
    ) : (
      <div class="absolute inset-0 flex items-center justify-center">
        <div class="text-center">
          <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" class="text-text/30 mx-auto mb-4">
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <circle cx="8.5" cy="8.5" r="1.5" />
            <polyline points="21 15 16 10 5 21" />
          </svg>
          <div class="text-[10px] tracking-[0.3em] text-text/40 font-bold">PHOTO COMING SOON</div>
        </div>
      </div>
    )}
  </div>

</section>
                <path d="M12 3C6.477 3 2 6.477 2 10.8c0 2.79 1.86 5.24 4.66 6.65l-1.18 4.3c-.11.4.33.72.68.5L11.2 19c.27.02.53.04.8.04 5.523 0 10-3.477 10-7.8S17.523 3 12 3z"/>

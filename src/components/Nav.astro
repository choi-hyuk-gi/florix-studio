---
const menu = [
  { href: '/#services', label: '서비스' },
  { href: '/#works', label: '시공 사례' },
  { href: '/#process', label: '시공 과정' },
  { href: '/#faq', label: 'FAQ' },
];
---

<header class="sticky top-0 z-50 bg-bg/95 backdrop-blur border-b border-line/50">
  <nav class="max-w-7xl mx-auto px-6 lg:px-12 py-5 flex items-center justify-between">

    <a href="/" class="flex items-center gap-1">
      <span class="text-base font-black tracking-[-0.02em] text-text">FLORIX</span>
      <span class="text-accent text-lg leading-none -mt-0.5">.</span>
      <span class="text-base font-black tracking-[-0.02em] text-text">STUDIO</span>
    </a>

    <ul class="hidden md:flex items-center gap-8">
      {menu.map(item => (
        <li>
          <a href={item.href} data-nav-link class="text-sm font-medium text-text hover:text-accent transition-colors">
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="hidden md:flex items-center gap-3 ml-8">
      <a href="https://blog.naver.com/florix_studios" target="_blank" rel="noopener noreferrer" aria-label="네이버 블로그" class="w-9 h-9 flex items-center justify-center text-text hover:text-accent transition-colors">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M16.273 12.845 7.376 0H0v24h7.726V11.156L16.624 24H24V0h-7.727v12.845Z"/>
        </svg>
      </a>
      <a href="https://www.instagram.com/florix_studios" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="w-9 h-9 flex items-center justify-center text-text hover:text-accent transition-colors">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
        </svg>
      </a>
    </div>

    <a href="/#cta" data-nav-link class="hidden md:inline-flex items-center gap-2 bg-text text-bg px-5 py-2.5 text-sm font-bold tracking-wider hover:bg-accent transition-colors">
      견적 문의 →
    </a>

    <div class="md:hidden flex items-center gap-2">
      <a href="https://blog.naver.com/florix_studios" target="_blank" rel="noopener noreferrer" aria-label="네이버 블로그" class="w-9 h-9 flex items-center justify-center text-text">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M16.273 12.845 7.376 0H0v24h7.726V11.156L16.624 24H24V0h-7.727v12.845Z"/>
        </svg>
      </a>
      <a href="https://www.instagram.com/florix_studios" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="w-9 h-9 flex items-center justify-center text-text">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
        </svg>
      </a>
      <button id="mobile-menu-btn" type="button" aria-label="메뉴 열기" class="w-9 h-9 flex items-center justify-center text-text">
        <svg id="icon-menu" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <svg id="icon-close" class="hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden md:hidden fixed inset-x-0 top-[68px] bottom-0 bg-bg z-40 overflow-y-auto">
    <div class="px-6 py-8 flex flex-col gap-1">
      {menu.map(item => (
        <a href={item.href} data-nav-link class="mobile-menu-link py-4 text-2xl font-bold text-text hover:text-accent transition-colors border-b border-line/40">
          {item.label}
        </a>
      ))}
      <a href="/#cta" data-nav-link class="mobile-menu-link mt-8 inline-flex items-center justify-center gap-2 bg-text text-bg px-6 py-4 text-base font-bold tracking-wider">
        견적 문의 →
      </a>
      <div class="flex items-center gap-4 mt-8 pt-8 border-t border-line/40">
        <a href="tel:01089302266" class="text-sm font-medium text-text">
          TEL · 010-8930-2266
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function() {
    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");
    const iconMenu = document.getElementById("icon-menu");
    const iconClose = document.getElementById("icon-close");

    function close() {
      if (!menu) return;
      menu.classList.add("hidden");
      iconMenu && iconMenu.classList.remove("hidden");
      iconClose && iconClose.classList.add("hidden");
      document.body.style.overflow = "";
    }
    function open() {
      if (!menu) return;
      menu.classList.remove("hidden");
      iconMenu && iconMenu.classList.add("hidden");
      iconClose && iconClose.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    }

    if (btn && menu) {
      btn.addEventListener("click", function() {
        if (menu.classList.contains("hidden")) open(); else close();
      });
      document.querySelectorAll(".mobile-menu-link").forEach(function(link) {
        link.addEventListener("click", close);
      });
    }

    // 네비 링크 클릭 처리: 같은 페이지면 부드러운 스크롤, 다른 페이지면 메인으로 이동
    document.querySelectorAll('a[data-nav-link]').forEach(function(link) {
      link.addEventListener('click', function(e) {
        var href = link.getAttribute('href') || '';
        // /#anchor 형태만 처리
        var m = href.match(/^\/#(.+)$/);
        if (!m) return;
        var id = m[1];
        var isHome = location.pathname === '/' || location.pathname === '/index.html';
        if (isHome) {
          // 메인 페이지: 부드럽게 스크롤
          var target = document.getElementById(id);
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            // URL hash 업데이트 (히스토리에는 안 쌓이게)
            history.replaceState(null, '', '/#' + id);
          }
        }
        // 다른 페이지(예: /works/...)면 그냥 기본 동작 → 메인으로 이동하면서 앵커
      });
    });
  })();
</script>

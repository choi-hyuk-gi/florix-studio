---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const works = (await getCollection('works')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout
  title="시공 사례 | 플로릭스 스튜디오"
  description="플로릭스 스튜디오의 콘크리트 폴리싱 시공 사례. 주거, 카페, 상업공간, 사무공간 등 다양한 공간의 시공 결과를 확인하세요."
>
  <Nav />

  <main class="min-h-screen bg-bg px-6 lg:px-12 pt-32 pb-24">
    <div class="max-w-7xl mx-auto">
      <header class="mb-20">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-8 h-px bg-accent"></div>
          <span class="text-[11px] font-bold tracking-[0.3em] uppercase text-accent">Selected Works</span>
        </div>
        <h1 class="text-5xl md:text-7xl font-black text-text leading-[0.95] tracking-[-0.045em]">
          시공 사례
        </h1>
        <p class="mt-6 text-mood text-base md:text-lg max-w-2xl leading-relaxed">
          모든 공간은 다릅니다. 같은 기준, 다른 결과. 플로릭스 스튜디오의 선별된 시공 기록입니다.
        </p>
      </header>

      {works.length === 0 ? (
        <div class="py-32 text-center">
          <p class="text-mood">곧 첫 시공 사례가 업데이트됩니다.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-16">
          {works.map((work) => (
            <a href={`/works/${work.id}/`} class="group block">
              <div class="relative aspect-[4/5] overflow-hidden bg-gradient-to-br from-[#D8CDB4] via-[#C9BCA0] to-[#B8AB8E] mb-5">
                <div class="absolute inset-0 flex items-center justify-center opacity-30 group-hover:opacity-50 transition-opacity">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" class="text-text/40">
                    <rect x="3" y="3" width="18" height="18" rx="2" />
                    <circle cx="8.5" cy="8.5" r="1.5" />
                    <polyline points="21 15 16 10 5 21" />
                  </svg>
                </div>
                <div class="absolute top-4 left-4">
                  <span class="text-[10px] font-bold tracking-[0.2em] uppercase text-text/60 bg-bg/80 px-3 py-1.5">
                    {work.data.category}
                  </span>
                </div>
                <div class="absolute bottom-4 right-4 text-[10px] tracking-[0.2em] text-text/40 font-mono">
                  No. {String(works.indexOf(work) + 1).padStart(3, '0')}
                </div>
              </div>

              <div>
                <h2 class="text-xl md:text-2xl font-bold text-text leading-tight tracking-[-0.02em] group-hover:text-accent transition-colors">
                  {work.data.title}
                </h2>
                <div class="mt-2 flex items-center gap-3 text-sm text-mood">
                  <span>{work.data.location}</span>
                  {work.data.area && (
                    <>
                      <span class="text-line">/</span>
                      <span>{work.data.area}㎡</span>
                    </>
                  )}
                </div>
                {work.data.specs && (
                  <p class="mt-3 text-xs text-mood/70 tracking-wide">
                    {work.data.specs}
                  </p>
                )}
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </main>

  <Footer />
</Layout>
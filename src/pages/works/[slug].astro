---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const works = await getCollection('works');
  return works.map((work) => ({
    params: { slug: work.id },
    props: { work },
  }));
}

interface Props { work: CollectionEntry<'works'>; }
const { work } = Astro.props;

const formattedDate = work.data.date.toLocaleDateString('ko-KR', {
  year: 'numeric', month: 'long', day: 'numeric'
});

// 텍스트 블록 정렬: **볼드**->strong, 줄바꿈->문단/<br> (HTML이면 그대로)
function formatBlockContent(raw) {
    if (!raw) return '';
    // 1. 짝이 맞는 **볼드** -> <strong> 변환 (HTML 유무와 무관하게 항상)
    let t = raw.replace(/\*\*([^*\n]+?)\*\*/g, '<strong>$1</strong>');
    // 2. 변환 후에도 남은 ** (짝 안 맞는 것)는 흔적 없이 제거 — 화면에 절대 노출 안 됨
    t = t.replace(/\*\*/g, '');
    // 3. 이미 HTML(<p>,<br>,<strong> 등)이 들어있으면 문단 처리 생략하고 그대로
    const hasHtml = /<(p|br|div|strong|b|h[1-6]|ul|li|em)\b/i.test(t);
    if (hasHtml) return t;
    // 4. 순수 텍스트만: 빈 줄로 문단 분리, 단일 줄바꿈은 <br>
    const paras = t.split(/\n{2,}/).map(p => p.trim()).filter(Boolean);
    return paras.map(p => '<p>' + p.replace(/\n/g, '<br>') + '</p>').join('');
}
---

<Layout title={`${work.data.title} | 플로릭스 스튜디오`} description={`${work.data.location} / ${work.data.category} 콘크리트 폴리싱`}>
  <Nav />
  <main class="min-h-screen bg-bg pt-24 pb-24">
    <article class="max-w-4xl mx-auto px-6 lg:px-12">

      <nav class="mb-12 text-sm text-mood">
        <a href="/" class="hover:text-accent transition-colors">홈</a>
        <span class="mx-2 text-line">/</span>
        <a href="/works/" class="hover:text-accent transition-colors">시공 사례</a>
        <span class="mx-2 text-line">/</span>
        <span class="text-text">{work.data.title}</span>
      </nav>

      <header class="mb-16">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-8 h-px bg-accent"></div>
          <span class="text-[11px] font-bold tracking-[0.3em] uppercase text-accent">{work.data.category}</span>
        </div>
        <h1 class="text-4xl md:text-6xl font-black text-text leading-[0.95] tracking-[-0.045em] mb-12">
          {work.data.title}
        </h1>
        <dl class="grid grid-cols-2 md:grid-cols-4 gap-y-6 gap-x-8 pt-8 border-t border-line">
          <div>
            <dt class="text-[10px] font-bold tracking-[0.2em] uppercase text-mood/70 mb-2">Location</dt>
            <dd class="text-sm text-text font-medium">{work.data.location}</dd>
          </div>
          {work.data.area && (
            <div>
              <dt class="text-[10px] font-bold tracking-[0.2em] uppercase text-mood/70 mb-2">Area</dt>
              <dd class="text-sm text-text font-medium">{work.data.area}㎡</dd>
            </div>
          )}
          <div>
            <dt class="text-[10px] font-bold tracking-[0.2em] uppercase text-mood/70 mb-2">Duration</dt>
            <dd class="text-sm text-text font-medium">{work.data.duration}</dd>
          </div>
          <div>
            <dt class="text-[10px] font-bold tracking-[0.2em] uppercase text-mood/70 mb-2">Date</dt>
            <dd class="text-sm text-text font-medium">{formattedDate}</dd>
          </div>
          {work.data.specs && (
            <div class="col-span-2 md:col-span-4">
              <dt class="text-[10px] font-bold tracking-[0.2em] uppercase text-mood/70 mb-2">Specs</dt>
              <dd class="text-sm text-text font-medium">{work.data.specs}</dd>
            </div>
          )}
        </dl>
      </header>

      {work.data.thumbnail && (
        <div class="mb-16 aspect-[16/9] overflow-hidden">
          <img src={work.data.thumbnail} alt={work.data.title} class="w-full h-full object-cover" />
        </div>
      )}

      {work.data.blocks && work.data.blocks.length > 0 && (
        <div class="space-y-10">
          {work.data.blocks.map((block) => (
            block.type === 'image' ? (
              <figure class="w-full">
                <img src={block.src} alt={block.caption ?? work.data.title} class="w-full object-cover" />
                {block.caption && (
                  <figcaption class="mt-3 text-xs text-mood text-center tracking-wide">{block.caption}</figcaption>
                )}
              </figure>
            ) : (
              <div class="prose-content max-w-none">
                <Fragment set:html={formatBlockContent(block.content)} />
              </div>
            )
          ))}
        </div>
      )}

      <div class="mt-24 pt-16 border-t border-line flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <a href="/works/" class="text-sm text-mood hover:text-accent transition-colors">← 모든 작업 보기</a>
        <a href="/#cta" class="inline-flex items-center gap-3 px-8 py-4 bg-text text-bg text-sm font-bold tracking-wider hover:bg-accent transition-colors">이런 공간 시공 문의 →</a>
      </div>

    </article>
  </main>
  <Footer />
</Layout>

<style>
  .prose-content :global(h2) { font-size: 1.5rem; font-weight: 800; color: var(--color-text); margin-top: 2.5rem; margin-bottom: 0.75rem; letter-spacing: -0.02em; }
  .prose-content :global(p) { font-size: 1rem; line-height: 1.85; color: var(--color-text); margin-bottom: 1rem; }
  .prose-content :global(ul) { margin: 1.25rem 0; padding-left: 0; list-style: none; }
  .prose-content :global(li) { position: relative; padding-left: 1.25rem; margin-bottom: 0.6rem; line-height: 1.75; }
  .prose-content :global(li::before) { content: ""; position: absolute; left: 0; top: 0.75em; width: 0.4rem; height: 1px; background: var(--color-accent); }
  .prose-content :global(strong) { font-weight: 700; }
</style>